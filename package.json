{
  "name": "gng-design-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/build.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.test.mjs",
    "check": "node --check build.mjs && for f in lib/*.mjs; do node --check $f; done"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-serif-jp": "^5.3.1",
    "cheerio": "1.1.2"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
