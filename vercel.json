{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": true,
  "images": {
    "sizes": [256, 384, 640, 960, 1280],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 2592000,
    "remotePatterns": [{ "protocol": "https", "hostname": "globalnightguide.com", "pathname": "/wp-content/uploads/**" }, { "protocol": "https", "hostname": "d8j0ntlcm91z4.cloudfront.net", "pathname": "/user_3GzEOW1cbzyPjySGkbYzv7L3rIa/**" }]
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://*.supabase.co https://globalnightguide.com https://secure.gravatar.com https://*.gravatar.com https://tiles.openfreemap.org; font-src 'self'; connect-src 'self' https://*.supabase.co https://tiles.openfreemap.org; worker-src 'self' blob:; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/search-index.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ]
}
